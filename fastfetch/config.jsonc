{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "#ffffff"
    },
    "padding": {
      "top": 1,
      "right": 4
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{#1}╭─────────────── {#}{user-name}"
    },

    {
      "type": "os",
      "key": "{#separator}│  {#keys}󰍹 os     ",
      "format": "{name}"
    },
    {
      "type": "command",
      "key": "{#separator}│  {#keys}󰃰 age    ",
      "text": "echo $(( ($(date +%s) - $(stat -c %W / 2>/dev/null || echo $(stat -c %Y /))) / 86400 )) days"
    },
    {
      "type": "kernel",
      "key": "{#separator}│  {#keys}󰒋 kernel "
    },
    {
      "type": "shell",
      "key": "{#separator}│  {#keys}󰞷 shell  "
    },
    {
      "type": "uptime",
      "key": "{#separator}│  {#keys}󰅐 uptime "
    },
    {
      "type": "packages",
      "key": "{#separator}│  {#keys}󰏖 pkgs   "
    },

    {
      "type": "custom",
      "format": "{#1}│"
    },

    {
      "type": "cpu",
      "key": "{#separator}│  {#keys}󰻠 cpu    ",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "{#separator}│  {#keys}󰢮 gpu    ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "{#separator}│  {#keys}󰍛 ram    ",
      "format": "{used} / {total}"
    },

    {
      "type": "command",
      "key": "{#separator}│  {#keys}󰋊 disk   ",
      "text": "df -h / | awk 'NR==2 {print $3 \" / \" $2}'"
    },

    {
      "type": "custom",
      "format": "{#1}│"
    },

    {
      "type": "display",
      "key": "{#separator}│  {#keys}󰹑 res    ",
      "format": "{width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "terminal",
      "key": "{#separator}│  {#keys}󰆍 term   ",
      "format": "{process-name}"
    },
    {
      "type": "wifi",
      "key": "{#separator}│  {#keys}󰤨 wifi   ",
      "format": "{ssid}"
    },
    {
      "type": "command",
      "key": "{#separator}│  {#keys}󰃶 date   ",
      "text": "date '+%d %B %Y  %H:%M'"
    },

    {
      "type": "custom",
      "format": "{#1}│"
    },

    {
      "type": "colors",
      "key": "{#separator}│",
      "symbol": "circle"
    },

    {
      "type": "custom",
      "format": "{#1}╰────────────────────────────────────╯"
    }
  ]
}
